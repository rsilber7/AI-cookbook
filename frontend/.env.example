VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Deployed backend URL. Leave unset in local dev: Vite forwards /api to localhost:8000
# VITE_API_URL=https://your-api.onrender.com

# Optional "Try the demo" button on the login page. This account's password is public
# by design, so use a throwaway demo account, never a real one.
# VITE_DEMO_EMAIL=demo@example.com
# VITE_DEMO_PASSWORD=choose-a-demo-password
